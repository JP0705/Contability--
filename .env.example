# Copie para .env e preencha os valores

# Groq (https://console.groq.com)
GROQ_API_KEY=sua_api_key
GROQ_MODEL=openai/gpt-oss-20b

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contability
DB_USER=postgres
DB_PASSWORD=postgres
# fuso usado para gravar/ler horários (created_at)
DB_TIMEZONE=America/Sao_Paulo

# Flask
FLASK_DEBUG=1
# chave de sessão (gere com: py -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque_por_uma_chave_aleatoria
